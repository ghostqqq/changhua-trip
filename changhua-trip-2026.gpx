<?xml version="1.0" encoding="UTF-8"?><gpx version="1.1" creator="Codex" xmlns="http://www.topografix.com/GPX/1/1"><metadata><name>彰化親子三日遊 2026/10/26–10/28</name><desc>地址核對於2026/10/26；路線點為停靠順序，不是即時道路導航。</desc></metadata><wpt lat="25.014753018047" lon="121.215528958112"><name>桃園高鐵站／青埔（暫定起點）</name><desc>桃園市中壢區高鐵北路一段6號；⚠️ 原專案只寫「青埔」，先以桃園高鐵站代替；請從實際住址開導航。</desc></wpt><wpt lat="23.953050996155" lon="120.486071035492"><name>阿枝羊肉店</name><desc>彰化縣溪湖鎮忠溪路226號；已核對地址；週一可安排，營業仍以店家當日公告為準。</desc></wpt><wpt lat="23.951545815892" lon="120.480782222227"><name>溪湖糖廠</name><desc>彰化縣溪湖鎮彰水路二段762號；已由台糖資料核對。</desc></wpt><wpt lat="23.895690489512" lon="120.530910361805"><name>田尾公路花園遊客中心</name><desc>彰化縣田尾鄉民族路一段156號；以遊客中心作為公路花園導航入口。</desc></wpt><wpt lat="23.85977101692" lon="120.586395040428"><name>周記蒸餃</name><desc>彰化縣田中鎮南北街94號；晚餐外帶候選；週一營業與供應請電話確認。</desc></wpt><wpt lat="23.859440979482" lon="120.582760982487"><name>老担高麗菜飯</name><desc>彰化縣田中鎮中正路367號；晚餐外帶候選；週一營業與供應請電話確認。</desc></wpt><wpt lat="23.858066012085" lon="120.588224977529"><name>美華鵝肉攤</name><desc>彰化縣田中鎮中州路一段141號；晚餐外帶候選；週一營業與供應請電話確認。</desc></wpt><wpt lat="23.875676695917" lon="120.574182131981"><name>馥御花園酒店</name><desc>彰化縣田中鎮站區路二段100號；已由旅宿官方與觀光資料核對。</desc></wpt><wpt lat="24.002984005028" lon="120.627523027653"><name>古生物奇幻樂園</name><desc>彰化縣芬園鄉中山路167號；已由參山國家風景區資料核對。</desc></wpt><wpt lat="24.013707979589" lon="120.629468970294"><name>芬園社口第一停車場（地址定位）</name><desc>彰化縣芬園鄉芬草路二段282號；⚠️ 以門牌旁作導航定位；車位及入口依現場。</desc></wpt><wpt lat="24.013378989889" lon="120.62897502474"><name>社口肉圓</name><desc>彰化縣芬園鄉芬草路二段303號；已核對地址；由停車場步行約3–5分鐘，當日營業仍請確認。</desc></wpt><wpt lat="24.01611098741" lon="120.655566025831"><name>埔茂花市</name><desc>彰化縣芬園鄉嘉中街505號；已由彰化旅遊資料核對。</desc></wpt><wpt lat="24.055449263538" lon="120.572234352567"><name>轉角秘密基地</name><desc>彰化縣花壇鄉環山路20號；已核對地址；晚間營業與候位請當日確認。</desc></wpt><wpt lat="24.057673353691" lon="120.431496923318"><name>鹿港老街（範圍定位）</name><desc>彰化縣鹿港鎮埔頭街；⚠️ 老街是範圍；導航後請依合法停車場停車。</desc></wpt><wpt lat="24.05751001512" lon="120.431611856548"><name>榮佳益智積木館</name><desc>彰化縣鹿港鎮埔頭街39號；地址資料曾見不同門牌；本版採縣府公開名單的埔頭街39號，請現場再確認。</desc></wpt><wpt lat="24.057781112983" lon="120.431449611593"><name>簡單美味工坊二號店</name><desc>彰化縣鹿港鎮埔頭街88號；採鹿港老街二號店；另有親民路188號的一號店。</desc></wpt><wpt lat="24.056218187028" lon="120.432844074281"><name>桂花巷藝術村</name><desc>彰化縣鹿港鎮桂花巷505號；已由鹿港鎮公所／彰化旅遊資料核對。</desc></wpt><wpt lat="24.077718017659" lon="120.542577971026"><name>大元餅行／大元鹹麻糬（彰化市，非鹿港）</name><desc>彰化縣彰化市民生路129巷6號；⚠️ 原行程寫在鹿港段，但核對後店址在彰化市；未放進鹿港主路線。</desc></wpt><wpt lat="23.927149993334" lon="120.319562014341"><name>芳苑普天宮停車場（海牛活動公開集合點）</name><desc>彰化縣芳苑鄉芳漢路芳二段161巷100號；⚠️ 公開資料集合點；真正集合地點與出發時間必須以預約業者通知為準。</desc></wpt><rte><name>Day 1｜10/26</name><desc>停靠順序；請由匯入App重新計算道路。</desc><rtept lat="25.014753018047" lon="121.215528958112"><name>桃園高鐵站／青埔（暫定起點）</name></rtept><rtept lat="23.953050996155" lon="120.486071035492"><name>阿枝羊肉店</name></rtept><rtept lat="23.951545815892" lon="120.480782222227"><name>溪湖糖廠</name></rtept><rtept lat="23.895690489512" lon="120.530910361805"><name>田尾公路花園遊客中心</name></rtept><rtept lat="23.85977101692" lon="120.586395040428"><name>周記蒸餃</name></rtept><rtept lat="23.875676695917" lon="120.574182131981"><name>馥御花園酒店</name></rtept></rte><rte><name>Day 2｜10/27</name><desc>停靠順序；請由匯入App重新計算道路。</desc><rtept lat="23.875676695917" lon="120.574182131981"><name>馥御花園酒店</name></rtept><rtept lat="24.002984005028" lon="120.627523027653"><name>古生物奇幻樂園</name></rtept><rtept lat="24.013707979589" lon="120.629468970294"><name>芬園社口第一停車場（地址定位）</name></rtept><rtept lat="24.013378989889" lon="120.62897502474"><name>社口肉圓</name></rtept><rtept lat="24.01611098741" lon="120.655566025831"><name>埔茂花市</name></rtept><rtept lat="24.055449263538" lon="120.572234352567"><name>轉角秘密基地</name></rtept><rtept lat="23.875676695917" lon="120.574182131981"><name>馥御花園酒店</name></rtept></rte><rte><name>Day 3｜10/28</name><desc>停靠順序；請由匯入App重新計算道路。</desc><rtept lat="23.875676695917" lon="120.574182131981"><name>馥御花園酒店</name></rtept><rtept lat="24.057673353691" lon="120.431496923318"><name>鹿港老街（範圍定位）</name></rtept><rtept lat="24.05751001512" lon="120.431611856548"><name>榮佳益智積木館</name></rtept><rtept lat="24.057781112983" lon="120.431449611593"><name>簡單美味工坊二號店</name></rtept><rtept lat="24.056218187028" lon="120.432844074281"><name>桂花巷藝術村</name></rtept><rtept lat="23.927149993334" lon="120.319562014341"><name>芳苑普天宮停車場（海牛活動公開集合點）</name></rtept><rtept lat="25.014753018047" lon="121.215528958112"><name>桃園高鐵站／青埔（暫定起點）</name></rtept></rte></gpx>
